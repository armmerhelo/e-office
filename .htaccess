<IfModule mod_rewrite.c>
    RewriteEngine On

    # ถ้ามีการเรียก document_new/file/xxxxx.pdf
    # ให้ส่งไปที่ api/file_request.php?Doc_Id=xxxxx.pdf
    RewriteRule ^file/([0-9]+)$ api/view_file.php?Doc_Id=$1 [L,QSA]
    RewriteRule ^(?:scripts|tests|test-results|email_send/backup)(?:/|$) - [F,L]
    RewriteRule ^email_send/(?:User_Data.*\.json|process_pdf_bup\.php)$ - [F,L,NC]
    RewriteRule ^e-sign/(?:e-sign-v1|e-sign_backup|e-sign_error|e-sign_6_10_69)\.php$ - [F,L]
</IfModule>
Options -Indexes
DirectoryIndex index.php index.html
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>
